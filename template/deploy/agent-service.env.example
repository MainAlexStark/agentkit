# Настройки агента. На VPS файл deploy/agent-service.env создаёт и дополняет deploy.sh;
# локально скопируйте этот пример в .env рядом с app/.

# ── общее ──
AGENT_NAME=Агент
AGENT_PUBLIC_URL=http://localhost:8080
AGENT_TZ=Europe/Moscow
# Локально — SQLite; на VPS deploy.sh подставит PostgreSQL.
AGENT_DATABASE_URL=sqlite:///data/agent.db

# ── модели (нужен хотя бы один провайдер) ──
AGENT_OPENROUTER_API_KEY=
AGENT_YANDEX_API_KEY=
AGENT_YANDEX_FOLDER_ID=
AGENT_OPENAI_API_KEY=
AGENT_OLLAMA_URL=
# «провайдер:модель». main — основная, small — сжатие истории, субагент explore, судья evals.
AGENT_MODEL_MAIN=openrouter:anthropic/claude-sonnet-4.5
AGENT_MODEL_SMALL=openrouter:anthropic/claude-haiku-4.5
# Избранные модели по умолчанию, через запятую (пусто — только main). Весь каталог OpenRouter
# подтягивается сам; каждый пользователь отмечает свои избранные в «Настройки → Модели».
AGENT_MODELS=openrouter:anthropic/claude-sonnet-4.5,openrouter:anthropic/claude-haiku-4.5,yandex:qwen3-235b-a22b-fp8/latest
# Какие модели каталога вообще доступны (шаблоны через запятую), пусто — все с инструментами.
# Админ может сузить список прямо в чате — тогда действует его выбор.
AGENT_MODELS_ALLOW=
# Запасные модели: основная=запасная1|запасная2;…
AGENT_FALLBACKS=openrouter:anthropic/claude-sonnet-4.5=openrouter:openai/gpt-5
AGENT_CONTEXT_WINDOW=200000
AGENT_MAX_STEPS=30
# low | medium | high — глубина рассуждений (если модель умеет)
AGENT_REASONING_EFFORT=

# ── инструменты ──
AGENT_TAVILY_API_KEY=
AGENT_ENABLE_FILES=true
AGENT_ENABLE_WEB=true
# Shell — только если контейнер изолирован и вы понимаете, что делаете.
AGENT_ENABLE_SHELL=false
AGENT_MCP_CONFIG=mcp.json

# ── права ──
# default | accept_edits | plan | readonly | auto | bypass
AGENT_DEFAULT_MODE=default
# Правила через запятую: "имя" или "имя(шаблон аргумента)"
AGENT_ALLOW_RULES=
AGENT_ASK_RULES=
AGENT_DENY_RULES=

# ── доступ ──
# Пользователи: id:токен:роль1+роль2 через запятую. deploy.sh заведёт admin.
AGENT_TOKENS=
# Токен хост-приложения (EI_doc, OpenSeller): пользователь — заголовками X-Agent-User-Id/-Name/-Roles.
AGENT_SERVICE_TOKEN=
AGENT_ALLOWED_ORIGINS=

# ── меню пользователя ──
# Тариф по умолчанию («Подписка»); настоящий биллинг — Domain.plan в app/domain.
AGENT_PLAN_NAME=
AGENT_MONTHLY_BUDGET_USD=0
AGENT_BILLING_URL=
AGENT_HELP_URL=

# ── процессы ──
# Больше одного процесса — только с Redis (deploy.sh подставит redis://redis:6379/0).
AGENT_WORKERS=1
AGENT_REDIS_URL=

# ── вложения ──
AGENT_MAX_UPLOAD_MB=25
# Модели, которым отдавать картинки (шаблоны через запятую); пусто — встроенный список.
AGENT_VISION_MODELS=

# ── компьютер, проекты, песочница ──
# Мост к компьютеру пользователя (Настройки → Компьютер) — инструменты pc_*.
AGENT_ENABLE_DEVICES=true
AGENT_ENABLE_PROJECTS=true
# Сколько текста файлов проекта класть прямо в промпт; больше — агент ищет по ним инструментом.
AGENT_PROJECT_INLINE_CHARS=40000
AGENT_MAX_PROJECT_FILE_MB=50
# Компьютер агента — run_python / run_bash. На VPS deploy.sh подставит http://sandbox:8090 и токен
# (контейнер на разговор). Локально: local — процессы на этой машине, без изоляции (только для
# разработки!), или agentkit sandbox --backend docker … и http://localhost:8090 (docs/new-agent.md).
AGENT_SANDBOX_URL=
AGENT_SANDBOX_TOKEN=
# Куда песочнице можно в интернет: домены через запятую (поддомены входят), * — всюду, пусто — никуда.
# После правки: ./deploy.sh update — он передаст список прокси egress.
AGENT_SANDBOX_EGRESS=pypi.org,files.pythonhosted.org
# Правки файлов в папке разговора (write_file / edit_file) — без подтверждения.
AGENT_WORKSPACE_EDITS=true

# ── прочее ──
AGENT_SCHEDULER=true
AGENT_TRACE_DIR=data/traces
